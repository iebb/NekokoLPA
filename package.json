{
  "name": "nekokolpa",
  "buildVersion": 372,
  "version": "1.12.372",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "start": "react-native start",
    "start:clean": "watchman watch-del-all && react-native start --reset-cache",
    "type-check": "tsc --noEmit",
    "pod-install": "cd ios && pod install && cd ..",
    "build": "bash build_variant.sh",
    "build:aab": "bash build_aab.sh",
    "build-all": "bash build_all_variants.sh",
    "build-all:aab": "bash build_all_aabs.sh",
    "build-and-upload": "bash build_variant.sh && bash release.sh",
    "bump": "python3 bump_version.py",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-native-documents/picker": "^11.0.0",
    "@react-native-ml-kit/barcode-scanning": "^2.0.0",
    "@react-navigation/drawer": "7.1.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/stack": "^7.4.2",
    "@reduxjs/toolkit": "2.5.1",
    "@tamagui/config": "1.135.7",
    "@tamagui/core": "1.135.7",
    "@tamagui/font-inter": "1.135.7",
    "@tamagui/lucide-icons": "1.135.7",
    "@tamagui/portal": "1.135.7",
    "@tamagui/shorthands": "1.135.7",
    "base64-js": "^1.5.1",
    "i18next": "24.2.2",
    "libphonenumber-js": "^1.11.19",
    "react": "19.2.0",
    "react-i18next": "14.1.3",
    "react-native": "^0.83.0",
    "react-native-ble-plx": "3.2.1",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-fs": "^2.18.0",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-image-picker": "7.1.2",
    "react-native-material-you-colors": "^0.1.2",
    "react-native-mmkv": "4.0.0",
    "react-native-nitro-modules": "0.31.4",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.1",
    "react-native-vision-camera": "^4.7.2",
    "react-native-worklets": "^0.7.0",
    "react-redux": "^9.2.0",
    "tamagui": "1.135.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "^0.83.0",
    "@react-native/eslint-config": "^0.83.0",
    "@react-native/metro-config": "^0.83.0",
    "@react-native/typescript-config": "^0.83.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19",
    "@typescript-eslint/parser": "^6.13.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "codegenConfig": {
    "name": "NekokoLPA",
    "type": "modules",
    "jsSrcsDir": "src/lpa/bridge/specs",
    "android": {
      "javaPackageName": "ee.nekoko.nlpa"
    },
    "ios": {
      "moduleName": "NekokoLPA"
    }
  },
  "packageManager": "yarn@3.6.4"
}
