# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

ENV['RCT_NEW_ARCH_ENABLED'] = '1'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end


target 'NekokoLPA' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )


  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(OTHER_CFLAGS)']
    end

    # User-suggested fix for Folly coroutines
    system("chmod -R u+w Pods/RCT-Folly")
    Dir.glob("Pods/RCT-Folly/folly/Portability.h").each do |file|
      text = File.read(file)
      new_contents = text.gsub('#define FOLLY_HAS_COROUTINES 1', '#define FOLLY_HAS_COROUTINES 0')
      File.open(file, "w") { |file| file.puts new_contents }
    end

    # fmt 11.0.2 does not build under Apple clang 17+ (Xcode 26): its
    # FMT_COMPILE_STRING consteval constructors are rejected as non-constant
    # expressions. RCT-Folly pins fmt to exactly 11.0.2, so the version cannot
    # be bumped; instead force the library onto its own pre-C++20 fallback,
    # which makes FMT_CONSTEVAL expand to nothing. base.h defines
    # FMT_USE_CONSTEVAL unconditionally, so a -D flag would just be overridden
    # and the source has to be edited in place.
    system("chmod -R u+w Pods/fmt")
    Dir.glob("Pods/fmt/include/fmt/base.h").each do |file|
      text = File.read(file)
      patched = text.gsub("#  define FMT_USE_CONSTEVAL 1", "#  define FMT_USE_CONSTEVAL 0")
      if text != patched
        File.open(file, "w") { |f| f.write(patched) }
        Pod::UI.puts "Patched fmt: forced FMT_USE_CONSTEVAL=0 for Apple clang compatibility".green
      end
    end
  end
end
